        "AD-PRIV-016"
      ],
      "steps": [
        {
          "name": "Helpdesk",
          "kind": "group",
          "object": "g-helpdesk",
          "via": "GenericWrite"
        },
        {
          "name": "APP01",
          "kind": "computer",
          "object": "c-app01",
          "via": "HasSession"
        },
        {
          "name": "adm-jsmith",
          "kind": "user",
          "object": "u-adm-jsmith",
          "via": "MemberOf"
        },
        {
          "name": "Domain Admins",
          "kind": "group",
          "object": "g-domain-admins"
        }
      ]
    },
